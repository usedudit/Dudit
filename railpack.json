{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "postgres-client-17": {
      "inputs": [
        {
          "image": "postgres:17-bookworm"
        }
      ],
      "commands": [
        "mkdir -p /opt/postgresql/lib && cp -a /usr/lib/postgresql/17 /opt/postgresql/ && cp -a /usr/lib/x86_64-linux-gnu/libpq.so.5* /opt/postgresql/lib/"
      ],
      "deployOutputs": [
        {
          "include": [
            "/opt/postgresql"
          ]
        }
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "...",
      "chromium",
      "fonts-liberation",
      "fonts-noto-color-emoji"
    ],
    "paths": [
      "/opt/postgresql/17/bin"
    ],
    "variables": {
      "PG_DUMP_BINARY": "/opt/postgresql/17/bin/pg_dump",
      "LD_LIBRARY_PATH": "/opt/postgresql/lib",
      "CHROMIUM_PATH": "/usr/bin/chromium"
    }
  }
}